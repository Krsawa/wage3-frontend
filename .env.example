# Rust API. Requests to /api/* are proxied here (see next.config.ts).
BACKEND_URL=http://localhost:8080

# Must match the backend's CHAIN_ID / BATCHER_ADDRESS / TOKEN_ADDRESS.
# Base Sepolia = 84532, Base mainnet = 8453
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BATCHER_ADDRESS=0x54737EaD375DD4b2c561c171e41e69A9EE2FfFcd
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Optional: a provider RPC; the public one is rate limited.
# NEXT_PUBLIC_RPC_URL=
